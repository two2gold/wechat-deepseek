# 统一换行符，避免跨平台踩坑
# - 源码/文档：仓库里存 LF
# - .cmd/.bat：必须 CRLF（cmd.exe 对 LF 的批处理解析会出错，见 README 的坑）
# - .sh：必须 LF（CRLF 会让 Linux 报 bad interpreter: /bin/bash^M）
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# 二进制：别做换行转换
*.png binary
*.jpg binary
*.ico binary
*.gz  binary
*.zip binary
*.7z  binary
*.exe binary
*.db  binary
