# ============================================================
# 微信公众号 × DeepSeek 配置文件
# 复制为 .env 后填写。所有值都不要加引号以外的多余空格。
# ============================================================

# ---------- 微信公众平台 ----------
# 服务器配置里的 Token，自己随便设一串（官方要求 3~32 位字母/数字/下划线），
# 必须和微信公众号后台「服务器配置」里填的 Token 完全一致
WECHAT_TOKEN=change_me_please

# 开发者ID（后台「设置与开发 - 基本配置」里，或测试号页面直接给出）
WECHAT_APPID=
# 开发者密码 AppSecret，只显示一次，务必保存好
WECHAT_APPSECRET=

# 消息加解密密钥：只有后台选择「安全模式」时才需要填（43 位字符串）
# 后台选择「明文模式」或「兼容模式」时留空即可
WECHAT_AES_KEY=

# ---------- DeepSeek ----------
# 到 https://platform.deepseek.com/api_keys 创建，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat（V3，快，推荐）/ deepseek-reasoner（R1，会思考，更慢更贵）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=1.0
DEEPSEEK_MAX_TOKENS=800
# 单次调用超时（秒）。reasoner 建议 90
DEEPSEEK_TIMEOUT=45
# 想改人设就改这里
# DEEPSEEK_SYSTEM_PROMPT=你是一个通过微信公众号为用户解答问题的 AI 助手……
# 本地联调时打开：不真正调用 DeepSeek，直接回显，方便验证整条链路
DEEPSEEK_MOCK=0

# ---------- 回复策略 ----------
# hybrid：能赶上就正常回复，赶不上先回一句"正在思考"再推送答案（推荐）
# instant_ack：立刻回"正在思考"，答案一律推送
# push：完全不被动回复，只用客服消息推送
# passive：只被动回复，超时给兜底文案（不调用客服接口）
REPLY_MODE=hybrid
# 微信硬性要求 5 秒内响应，这里留足余量
PASSIVE_TIMEOUT=3.5
ACK_TEXT=收到啦，正在思考中……请稍等几秒 🧠
FALLBACK_TEXT=这个问题有点费脑，我再想想，稍后把答案发给你～
WELCOME_TEXT=你好呀！我是接入 DeepSeek 的 AI 助手，直接把问题发给我就行～
UNSUPPORTED_TEXT=我目前只能读懂文字消息哦，发一段文字试试～
# 微信文本上限 2048 字节，这里留余量（中文 1 字 3 字节）
MAX_REPLY_BYTES=1800
MAX_INPUT_CHARS=800
# 把 DeepSeek 输出的 Markdown 语法降级为纯文本，微信里更好看
STRIP_MARKDOWN=1
# 客服消息最多分几块发送
PUSH_MAX_CHUNKS=3

# ---------- 会话记忆 ----------
# 记住最近几轮对话（1 轮 = 一问一答），设 0 即为无记忆
HISTORY_TURNS=6
# 会话有效期（秒）
SESSION_TTL=3600
DB_PATH=data/sessions.db

# ---------- 风控 ----------
RATE_LIMIT_SECONDS=1.0
RATE_LIMIT_PER_HOUR=60
DEDUPE_TTL=300
# 同时进行的 DeepSeek 请求数上限
MAX_CONCURRENCY=4

# 白名单：留空 = 所有关注者都能用（默认）。
# 想只让自己/指定的人用，就填 openid，多个用逗号分隔（用 tools/send_message.py --list 查看）：
#   ALLOWED_OPENIDS=oXXXX_你的_openid,oYYYY_另一个_openid
ALLOWED_OPENIDS=
NOT_ALLOWED_TEXT=抱歉，这个公众号目前只对指定用户开放～

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# 公网隧道固定子域名：在 https://admin.localhost.run/ 注册公钥后填这里，例如 wxai
TUNNEL_SUBDOMAIN=
# 运维提醒收件人 openid（地址变更时用客服消息通知），多个逗号分隔
NOTIFY_OPENIDS=
# 隧道服务商：localhost.run（当前默认，域名已被微信验证可达）或 serveo（注册后可拿固定子域）
TUNNEL_PROVIDER=localhost.run
